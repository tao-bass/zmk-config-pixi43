#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&Macro_to_layer_0>;
            key-positions = <0 1>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
        };
    };

    macros {
        Macro_to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp INT_MUHENKAN>; // to 2から修正（通常0がベースのため）
            label = "TO_LAYER_0";
        };

        Macro_enter_and_to_0: num_to_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER &to 0 &kp INTERNATIONAL_4>;
            label = "NUM_TO_ENTER";
        };

        Macro_Win_layer_Henkan: Win_layer_Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp INT_HENKAN>;
            label = "WIN_LAYER_HIRAGANA";
        };

        Macro_Win_layer_Muhenkan: Macro_Win_layer_Muhenkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp INT_MUHENKAN>;
            label = "MACRO_WIN_LAYER_MUHENKAN";
        };

        Macro_NUM_Muhenkan: NUM_Muhenkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &kp INT_MUHENKAN>;
            label = "NUM_MUHENKAN";
        };
    };

    behaviors {
        Behavior_lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&Macro_to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用のスクロール設定

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        Behavior_Henkan_Muhenkan: Behavior_Henkan_Muhenkan {
            compatible = "zmk,behavior-tap-dance";
            label = "BEHAVIOR_HENKAN_MUHENKAN";
            #binding-cells = <0>;
            bindings =
                <&Macro_Win_layer_Henkan>,
                <&Macro_NUM_Muhenkan>,
                <&Macro_Win_layer_Muhenkan>;

            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Win_layer {
            bindings = <
&kp TAB         &kp W         &kp E         &kp R            &kp T                                                                             &kp Y        &kp U    &lt 5 I    &kp O    &kp P
&kp A           &kp S         &kp D         &kp F            &kp G        &kp LS(LG(S))                             &kp INT_MUHENKAN           &kp H        &kp J    &kp K      &kp L    &kp MINUS
&kp Z           &kp X         &kp C         &kp V            &kp B        &kp Q                                     &kp GRAVE                  &kp N        &lt 6 M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 BACKSPACE  &lt 6 SPACE  &Behavior_lt_to_layer_0 3 LANGUAGE_6      &Behavior_Henkan_Muhenkan  &lt 5 ENTER                               &Macro_NUM_Muhenkan
            >;

            // 左手エンコーダに作成したスクロールBehaviorを適用

            sensor-bindings = <&scroll_up_down>;
        };

        NUM {
            bindings = <
&kp F9                      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                          &mt KP_NUMBER_9 ASTRK  &kp KP_NUMBER_7    &lt 5 KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp MINUS              &kp SLASH              &kp KP_NUMBER_4    &kp KP_NUMBER_5    &kp KP_NUMBER_6  &kp BACKSPACE
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &kp PLUS               &kp KP_NUMBER_0        &lt 6 KP_NUMBER_1  &kp KP_NUMBER_2    &kp KP_NUMBER_3  &kp PERIOD
&trans                      &trans           &trans           &trans           &kp ENTER     &trans                       &Macro_enter_and_to_0  &lt 5 ENTER                                                                   &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Win_FUNCTION {
            bindings = <
&trans     &kp LC(W)  &kp LC(E)  &kp LC(R)  &kp LC(T)                          &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp LC(A)  &kp LC(S)  &kp LC(D)  &kt LC(F)  &kp LC(G)  &trans         &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kt LC(B)  &kp RC(Q)      &trans   &trans  &trans  &trans  &trans  &kp F11
&trans     &trans     &trans     &trans     &trans     &trans         &trans   &trans                          &kp F12
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp LC(LG(D))           &kp RC(RS(TAB))  &kp UP_ARROW    &kp RC(TAB)      &kp LC(LG(F4))
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LG(LC(LEFT_ARROW))  &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LC(LG(RIGHT_ARROW))
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                  &trans           &trans          &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                                    &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &out OUT_TOG
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        symbol {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LESS_THAN         &kp GREATER_THAN       &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EXCLAMATION  &kp QUESTION
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                                &trans
            >;
        };
    };
};
